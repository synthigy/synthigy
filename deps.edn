{:mvn/repos {"rpl" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}
             "central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 ;; Core paths - the engine: dataset, IAM, xsql, the /data verb executor.
 ;; No server, no OAuth provider, no console — those are the :server-*
 ;; aliases. synthigy.embedded runs on this alone.
 :paths ["core/src" "resources" "xsql/src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  org.clojure/core.async {:mvn/version "1.6.681"}
  org.clojure/core.cache {:mvn/version "1.1.234"}
  metosin/jsonista {:mvn/version "0.3.13"}
  com.cognitect/transit-clj {:mvn/version "1.0.333"}

;; Auth/Crypto
  buddy/buddy-sign {:mvn/version "3.6.1-359"}
  buddy/buddy-core {:mvn/version "1.12.0-430"}
  buddy/buddy-hashers {:mvn/version "2.0.167"}

  ;; Utilities
  nano-id/nano-id {:mvn/version "1.1.0"}
  dev.gersak/patcho {:local/root "patcho"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
  babashka/fs {:mvn/version "0.5.22"}

;; Configuration
  environ/environ {:mvn/version "1.2.0"}

  ;; Logging
  ;; Pin SLF4J 2.x — telemere-slf4j is an SLF4J 2.x provider, but HikariCP
  ;; transitively requests slf4j-api 1.7.x which can win some alias mixes
  ;; and force SLF4J into NOP fallback (logs silently dropped). Explicit pin.
  org.slf4j/slf4j-api {:mvn/version "2.0.16"}
  com.taoensso/telemere {:mvn/version "1.2.1"}
  com.taoensso/telemere-slf4j {:mvn/version "1.2.1"}}

 :aliases
 {;; One folder = one alias = one jar: <dimension>/<impl>/src → :<dimension>-<impl>.
  ;; build.clj discovers the folders and refuses a folder without its alias.

  ;; =========================================================================
  ;; Engine — exactly one per classpath, each ships `synthigy.core`
  ;; =========================================================================
  :engine-postgres
  {:extra-paths ["engine/postgres/src"]
   :extra-deps {org.postgresql/postgresql {:mvn/version "42.7.4"}
                com.zaxxer/HikariCP {:mvn/version "6.2.1"}}}

  :engine-sqlite
  {:extra-paths ["engine/sqlite/src"]
   :extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.47.1.0"}
                com.zaxxer/HikariCP {:mvn/version "6.2.1"}}}

  :engine-cockroach
  {:extra-paths ["engine/cockroach/src"]
   :extra-deps {org.postgresql/postgresql {:mvn/version "42.7.4"}
                com.zaxxer/HikariCP        {:mvn/version "6.2.1"}}}

  ;; compile witness: core builds against it, nothing ships it
  :engine-stub
  {:extra-paths ["engine/stub/src"]}

  ;; =========================================================================
  ;; Audit — exactly one per classpath, each ships `synthigy.audit`
  ;; =========================================================================
  ;; :audit-postgres writes in the Postgres drain transaction, so it needs :engine-postgres.
  :audit-postgres
  {:extra-paths ["audit/postgres/src"]
   :extra-deps {org.postgresql/postgresql {:mvn/version "42.7.4"}}}

  :audit-sqlite
  {:extra-paths ["audit/sqlite/src"]
   :extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.47.1.0"}}}

  :audit-clickhouse
  {:extra-paths ["audit/clickhouse/src"]}

  :audit-memory
  {:extra-paths ["audit/memory/src"]}

  :audit-duckdb
  {:extra-paths ["audit/duckdb/src"]}

  ;; =========================================================================
  ;; Log store + traffic — exactly one per classpath, each ships `synthigy.log.store`
  ;; =========================================================================
  :log-sqlite
  {:extra-paths ["log/sqlite/src"]
   :extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.47.1.0"}}}

  :log-clickhouse
  {:extra-paths ["log/clickhouse/src"]}

  :log-memory
  {:extra-paths ["log/memory/src"]}

  :log-duckdb
  {:extra-paths ["log/duckdb/src"]}

  
  ;; =========================================================================
  ;; Libraries — on a module's classpath, never shipped as a dimension
  ;; =========================================================================
  ;; ClickHouse over HTTP — both ClickHouse modules need it; no driver.
  :lib-clickhouse
  {:extra-paths ["lib/clickhouse/src"]}

  ;; embedded DuckDB — the driver both DuckDB modules need. Source only: no
  ;; bundle ships DuckDB, and build.clj builds no jar for it.
  :lib-duckdb
  {:extra-paths ["lib/duckdb/src"]
   :extra-deps {org.duckdb/duckdb_jdbc {:mvn/version "1.1.3"}}}

  ;; =========================================================================
  ;; Server — layers (core, oauth, console) + exactly one adapter
  ;; =========================================================================
  ;; The engine (base :paths) runs standalone — synthigy.embedded proves it.
  ;; :server-oauth loads with no server present; :server-core requires it
  ;; (routes.clj requires synthigy.oauth.handlers). Every adapter and
  ;; :server-console pull both layers' paths themselves — deps.edn has no
  ;; "alias requires alias", so they are repeated; tools.deps dedupes paths.

  :server-oauth
  {:extra-paths ["server/oauth/src"]
   :extra-deps {ring/ring-core {:mvn/version "1.12.2"}
                hiccup/hiccup {:mvn/version "2.0.0-RC3"}}}

  :server-core
  {:extra-paths ["server/core/src"]}

  ;; :local/root, so the console's paths AND deps come from
  ;; server/console/deps.edn; its :deps omit core (the edge back lives in its :dev alias).
  :server-console
  {:extra-paths ["server/oauth/src" "server/core/src"]
   :extra-deps {dev.synthigy/console {:local/root "server/console"}}}

  ;; Adapters — exactly one per classpath, each ships `synthigy.server`.
  :server-httpkit
  {:extra-paths ["server/httpkit/src" "server/oauth/src" "server/core/src"]
   :extra-deps {http-kit/http-kit {:mvn/version "2.8.0"}
                ring/ring-core {:mvn/version "1.12.2"}
                hiccup/hiccup {:mvn/version "2.0.0-RC3"}
                ;; Datastar SSE adapter for this backend. Pulls http-kit
                ;; 2.9.0-beta3 transitively; our 2.8.0 pin wins (:use-top).
                dev.data-star.clojure/http-kit {:mvn/version "1.0.0-RC11"}}}

  :server-pedestal
  {:extra-paths ["server/pedestal/src" "server/oauth/src" "server/core/src"]
   :extra-deps {io.pedestal/pedestal.service {:mvn/version "0.7.0"}
                io.pedestal/pedestal.route {:mvn/version "0.7.0"}
                io.pedestal/pedestal.jetty {:mvn/version "0.7.0"}
                hiccup/hiccup {:mvn/version "2.0.0-RC3"}}}

  :server-undertow
  {:extra-paths ["server/undertow/src" "server/oauth/src" "server/core/src"]
   :extra-deps {luminus/ring-undertow-adapter {:mvn/version "1.3.1"}
                ring/ring-core {:mvn/version "1.12.2"}
                hiccup/hiccup {:mvn/version "2.0.0-RC3"}}}

  :server-ring-jetty
  {:extra-paths ["server/ring-jetty/src" "server/oauth/src" "server/core/src"]
   :extra-deps {ring/ring-jetty-adapter {:mvn/version "1.15.4"}
                ring/ring-core {:mvn/version "1.15.4"}
                hiccup/hiccup {:mvn/version "2.0.0-RC3"}
                ;; Datastar SSE adapter, built on StreamableResponseBody —
                ;; which this backend honours (undertow does not, so it gets
                ;; no transport and its console renders static).
                dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}}}

  ;; =========================================================================
  ;; Development & Testing
  ;; =========================================================================
  ;; Usage: clj -M:engine-postgres:audit-postgres:log-sqlite:server-httpkit:server-console:dev

  :dev
  {:extra-paths ["dev" "test" "test/resources"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                dev.synthigy/console {:local/root "server/console"}
                clj-http/clj-http {:mvn/version "3.13.0"}
                ;; Dev-only profiling. NOT on production classpath —
                ;; only loaded under the :dev alias. See dev/synthigy/profiling.clj.
                com.taoensso/tufte {:mvn/version "2.6.3"}
                com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.5.1"}}}

  ;; dev/dreamcatcher_spike.clj — needs a sibling dreamcatcher checkout
  :dreamcatcher
  {:extra-deps {dev.gersak/dreamcatcher {:local/root "../../gersak/dreamcatcher"}}}

  :test
  {:extra-paths ["test" "test/resources" "xsql/test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                org.clojure/tools.logging {:mvn/version "1.3.0"}
                nubank/matcher-combinators {:mvn/version "3.9.1"}
                clj-http/clj-http {:mvn/version "3.13.0"}
                dev.synthigy/console {:local/root "server/console"}}
   :main-opts ["-m" "kaocha.runner"]}

  :repl
  {:main-opts ["-m" "nrepl.cmdline" "--interactive" "--color"]}

  ;; XSQL → generated embedded source. Needs ONE database backend and nothing
  ;; else — `describe` compiles against the DEPLOYED model, which lives in the
  ;; DB:
  ;;
  ;;   clj -X:gen                 (PostgreSQL — the backend baked in below)
  ;;   clj -X:engine-sqlite:gen   (or :engine-cockroach:gen … — leftmost alias wins the
  ;;                               `synthigy.core` shadow, so it overrides)
  ;;
  ;; No endpoint and no credentials, unlike sdk/clj's `:gen`, which must reach
  ;; a running backend over HTTP because the XSQL compiler lives here;
  ;; in-process there is nothing to reach. Output is COMMITTED source (it is on
  ;; console's :paths); regenerate whenever resources/xsql changes.
  :gen
  {:extra-paths ["engine/postgres/src" "audit/memory/src" "log/memory/src"]
   :extra-deps {org.postgresql/postgresql {:mvn/version "42.7.4"}
                com.zaxxer/HikariCP {:mvn/version "6.2.1"}}
   :exec-fn synthigy.embedded.gen/generate!
   :exec-args {:dir "resources/xsql"
               :out "server/console/gen"
               :ns-prefix "synthigy.xsql"}}

  ;; Uberjar builder (see build.clj). Combo via SYNTHIGY_COMBO env.
  :build
  {:extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
   :ns-default build}}}
