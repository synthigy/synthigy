{:mvn/repos {"rpl" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}
             "central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 ;; Core paths - shared code that doesn't depend on a specific database or server
 :paths ["core/src" "lacinia" "resources" "auth" "xsql/src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  org.clojure/core.async {:mvn/version "1.6.681"}
  org.clojure/core.cache {:mvn/version "1.1.234"}
  metosin/jsonista {:mvn/version "0.3.13"}
  com.cognitect/transit-clj {:mvn/version "1.0.333"}

;; Auth/Crypto
  buddy/buddy-sign {:mvn/version "3.6.1-359"}
  buddy/buddy-core {:mvn/version "1.12.0-430"}
  buddy/buddy-hashers {:mvn/version "2.0.167"}

  ;; Utilities
  nano-id/nano-id {:mvn/version "1.1.0"}
  dev.gersak/patcho {:local/root "patcho"}
  camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
  babashka/fs {:mvn/version "0.5.22"}

;; Configuration
  environ/environ {:mvn/version "1.2.0"}

  ;; Logging
  ;; Pin SLF4J 2.x — telemere-slf4j is an SLF4J 2.x provider, but HikariCP
  ;; transitively requests slf4j-api 1.7.x which can win some alias mixes
  ;; and force SLF4J into NOP fallback (logs silently dropped). Explicit pin.
  org.slf4j/slf4j-api {:mvn/version "2.0.16"}
  com.taoensso/telemere {:mvn/version "1.2.1"}
  com.taoensso/telemere-slf4j {:mvn/version "1.2.1"}}

 :aliases
 {;; GraphQL
  :graphql
  {:extra-paths ["lacinia"]
   :extra-deps {com.walmartlabs/lacinia {:mvn/version "1.2.2"}}}

  ;; =========================================================================
  ;; Database Backends
  ;; =========================================================================
  ;; Choose ONE database backend - these provide synthigy.db namespace
  ;; that shadows core and loads backend-specific implementations

  :postgres
  {:extra-paths ["postgres/src"]
   :extra-deps {org.postgresql/postgresql {:mvn/version "42.7.4"}
                ;; Database (shared JDBC infrastructure - drivers are backend-specific)
                com.zaxxer/HikariCP {:mvn/version "6.2.1"}}}

  :sqlite
  {:extra-paths ["sqlite/src"]
   :extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.47.1.0"}
                ;; Database (shared JDBC infrastructure - drivers are backend-specific)
                com.zaxxer/HikariCP {:mvn/version "6.2.1"}}}

  ;; CockroachDB — packages as synthigy-crdb. Speaks PG wire so uses the
  ;; postgres JDBC driver, but has its own dataset / substrate / audit
  ;; ports under cockroach/src (CRDB plpgsql differences, no LISTEN/NOTIFY,
  ;; no statement-level triggers — substrate follows the SQLite pattern).
  :crdb
  {:extra-paths ["cockroach/src"]
   :extra-deps {org.postgresql/postgresql {:mvn/version "42.7.4"}
                com.zaxxer/HikariCP        {:mvn/version "6.2.1"}}}

  ;; DuckDB — embedded columnar observability substrate. NOT a system DB
  ;; backend; the JDBC jar is bundled here so the optional
  ;; :synthigy/observability module under duckdb/src can serve as durable
  ;; storage for logs + audit without needing a separate server. In-memory
  ;; by default; flip to file via SYNTHIGY_OBSERVABILITY_PATH. Pick this
  ;; for OSS dev (queryable cockpit history with zero ops).
  :duckdb
  {:extra-paths ["duckdb/src"]
   :extra-deps {org.duckdb/duckdb_jdbc {:mvn/version "1.1.3"}}}

  ;; ClickHouse observability substrate — analytical scale, multi-node.
  ;; CH speaks pure HTTP so no JDBC driver needed; the impl uses Java 11+
  ;; java.net.http. The :synthigy/observability module under clickhouse/src
  ;; provides the same shadowed namespace as the DuckDB variant — operators
  ;; pick :duckdb OR :clickhouse, never both.
  :clickhouse
  {:extra-paths ["clickhouse/src"]}

  ;; Stub for compilation without a real database backend
  :stub
  {:extra-paths ["dummy/src"]}

  ;; =========================================================================
  ;; Server Backends
  ;; =========================================================================
  ;; Choose ONE server backend - these provide synthigy.server and synthigy.admin
  ;; namespaces that shadow core and load server-specific implementations

  :pedestal
  {:extra-paths ["pedestal/src"]
   :extra-deps {io.pedestal/pedestal.service {:mvn/version "0.7.0"}
                io.pedestal/pedestal.route {:mvn/version "0.7.0"}
                io.pedestal/pedestal.jetty {:mvn/version "0.7.0"}
                hiccup/hiccup {:mvn/version "2.0.0-RC3"}}}

  :httpkit
  {:extra-paths ["httpkit/src"]
   :extra-deps {http-kit/http-kit {:mvn/version "2.8.0"}
                ring/ring-core {:mvn/version "1.12.2"}
                hiccup/hiccup {:mvn/version "2.0.0-RC3"}}}

  :undertow
  {:extra-paths ["undertow/src"]
   :extra-deps {luminus/ring-undertow-adapter {:mvn/version "1.3.1"}
                ring/ring-core {:mvn/version "1.12.2"}
                hiccup/hiccup {:mvn/version "2.0.0-RC3"}}}

  :ring-jetty
  {:extra-paths ["ring-jetty/src"]
   :extra-deps {ring/ring-jetty-adapter {:mvn/version "1.15.4"}
                ring/ring-core {:mvn/version "1.15.4"}
                hiccup/hiccup {:mvn/version "2.0.0-RC3"}}}

  ;; =========================================================================
  ;; Development & Testing
  ;; =========================================================================
  ;; Usage: clj -M:postgres:pedestal:dev
  ;;    or: clj -M:sqlite:pedestal:dev

  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                clj-http/clj-http {:mvn/version "3.13.0"}
                ;; Dev-only profiling. NOT on production classpath —
                ;; only loaded under the :dev alias. See dev/synthigy/profiling.clj.
                com.taoensso/tufte {:mvn/version "2.6.3"}
                com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.5.1"}
                ;; Dev-only spike: Dreamcatcher state machine over the
                ;; subscription bus. See dev/dreamcatcher_spike.clj.
                dev.gersak/dreamcatcher {:local/root "../../gersak/dreamcatcher"}}}

  :test
  {:extra-paths ["test" "xsql/test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                org.clojure/tools.logging {:mvn/version "1.3.0"}
                nubank/matcher-combinators {:mvn/version "3.9.1"}
                clj-http/clj-http {:mvn/version "3.13.0"}}
   :main-opts ["-m" "kaocha.runner"]}

  :repl
  {:main-opts ["-m" "nrepl.cmdline" "--interactive" "--color"]}

  ;; Uberjar builder (see build.clj). Combo via SYNTHIGY_COMBO env.
  :build
  {:extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
   :ns-default build}}}
