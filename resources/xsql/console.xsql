@workspace "Console"
@namespace console

@search users-table
@watch
user (
  name ilike ?q?
  and groups.xid in ?groups?[]
  and roles.xid in ?roles?[],
  order by ?sort:order(name, active, sessions, groups, roles)="name asc",
  limit ?limit:int=100,
  offset ?offset:int=0
)
  xid
  name
  active
  type
  groups: count(groups)
  roles: count(roles)
  sessions: count(sessions.active = true)

@search groups-table
@watch
user_group (
  name ilike ?q?,
  order by ?sort:order(name, active, users, roles)="name asc",
  limit ?limit:int=100,
  offset ?offset:int=0
)
  xid
  name
  active
  users: count(users)
  roles: count(roles)

@search roles-table
@watch
user_role (
  name ilike ?q?,
  order by ?sort:order(name, active, users, scopes)="name asc",
  limit ?limit:int=100,
  offset ?offset:int=0
)
  xid
  name
  active
  users: count(users)
  scopes: count(scopes)

@search apps-table
@watch
oauth_client (
  name ilike ?q?,
  order by ?sort:order(name, active, apis)="name asc",
  limit ?limit:int=100,
  offset ?offset:int=0
)
  xid
  name
  active
  type
  apis: count(apis)

@search apis-table
@watch
oauth_api (
  name ilike ?q?,
  order by ?sort:order(name, apps, scopes)="name asc",
  limit ?limit:int=100,
  offset ?offset:int=0
)
  xid
  name
  audience
  apps: count(clients)
  scopes: count(scopes)

@search providers-table
@watch
federation_provider (
  provider ilike ?q?,
  order by ?sort:order(provider, active)="provider asc",
  limit ?limit:int=100,
  offset ?offset:int=0
)
  xid
  provider
  active

@search connectors-table
@watch
auth_connector (
  name ilike ?q?,
  order by ?sort:order(priority, name, type, enabled)="priority asc, name asc",
  limit ?limit:int=100,
  offset ?offset:int=0
)
  xid
  name
  type
  priority
  enabled

@sql-template users-count
@returns total:int
select count({user.xid}) as total

@sql-template groups-count
@returns total:int
select count({user_group.xid}) as total

@sql-template roles-count
@returns total:int
select count({user_role.xid}) as total

@sql-template apps-count
@returns total:int
select count({oauth_client.xid}) as total

@sql-template apis-count
@returns total:int
select count({oauth_api.xid}) as total
